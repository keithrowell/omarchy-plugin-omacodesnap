#!/usr/bin/env bash
# Launch Omasnap as a standalone Quickshell process.
#
#   bin/omasnap                                                    # live: snap the current selection and preview it
#   bin/omasnap --benchmark [--language X]                          # time the non-window steps of the live path
#   bin/omasnap --fixture F --out P [--theme-dir D] [--wallpaper W] # headless fixture render
#
# Live mode (see the plan for spec 0006) never puts the selection text in a
# shell variable, argv, or a shell invocation: `wl-paste` writes straight to
# a 0600 file, `lib/snap.mjs` (Node) reads that file and writes JSON, and
# `app/Main.qml`'s preview mode reads the JSON. The only `sh -c` on the
# whole run path is inside `app/Preview.qml`'s Copy action, and it only ever
# sees our own rendered PNG's path.
#
# Fixture/render mode runs `lib/input.mjs` with Node to build one JSON input
# (the fixture's spans resolved against a theme), then starts `qs` with
# OMASNAP_INPUT/OMASNAP_OUT set; `app/Main.qml`'s render mode grabs the
# frame to `--out` and quits. See the plan for spec 0004.
set -euo pipefail

# Every file this script creates below (the selection/window/request/input
# files, the runtime directory itself) must be private to this user: the
# selection text passes through one of them. `mkdir -m 700`/similar only
# sets a directory's mode at the moment it's *created* — it has no effect
# if the directory already exists, and does nothing at all for a plain `>`
# redirect or `mkdir -p`'s intermediate parents. A restrictive umask, set
# once here before anything is created, is what actually guarantees it:
# every subsequent `mkdir`, redirect, and Node `writeFileSync` in this
# script (and in `lib/snap.mjs`/`lib/input.mjs`, which inherit it) comes out
# 0700/0600 regardless of the umask this script was invoked with (a
# Hyprland-launched process typically inherits systemd's default 022).
umask 077

usage() {
  echo "usage: bin/omasnap [--benchmark] [--language X]"
  echo "       bin/omasnap --fixture F --out P [--theme-dir D] [--wallpaper W]"
}

if ! command -v qs >/dev/null 2>&1; then
  echo "omasnap: 'qs' (Quickshell) was not found on PATH." >&2
  echo "Install it with: sudo pacman -S quickshell" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

# Errors (not `set -u`'s generic "unbound variable") on a flag with no
# following value, e.g. a trailing `--out` with nothing after it.
require_value() {
  if [ "$#" -lt 2 ]; then
    echo "omasnap: $1 requires a value" >&2
    usage >&2
    exit 2
  fi
}

# `${XDG_RUNTIME_DIR:-/tmp}` (the old fallback) put our per-run scratch
# files, including the raw selection text, under a directory every account
# on the machine can read and write when the variable happens to be unset.
# Fail closed instead — systemd/uwsm always sets it for a real login
# session, so this only ever fires in a stripped-down environment that
# shouldn't be handling a selection anyway.
require_runtime_dir() {
  if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    echo "omasnap: XDG_RUNTIME_DIR is not set; refusing to fall back to shared /tmp" >&2
    exit 1
  fi
  printf '%s\n' "$XDG_RUNTIME_DIR"
}

# `mkdir -p -m 700` only sets the mode at the moment it *creates* the
# directory — it's a silent no-op if anything, including a symlink or a
# directory some other same-user process created first, already exists at
# that path. Verify what we actually got before trusting it with the
# selection text: a real directory (not a symlink), owned by us, mode 700.
# Refuse rather than repair — a directory that isn't ours to begin with
# might already be watched or replaced by whatever put it there.
verify_private_dir() {
  local dir="$1"
  if [ -L "$dir" ] || [ ! -d "$dir" ]; then
    echo "omasnap: $dir exists and is not a plain directory; refusing to use it" >&2
    exit 1
  fi
  local owner mode
  owner="$(stat -c '%u' "$dir")"
  mode="$(stat -c '%a' "$dir")"
  if [ "$owner" != "$(id -u)" ] || [ "$mode" != "700" ]; then
    echo "omasnap: $dir is not a private directory (owner $owner, mode $mode); refusing to use it" >&2
    exit 1
  fi
}

FIXTURE=""
OUT=""
THEME_DIR=""
WALLPAPER=""
BENCHMARK=0
LANGUAGE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --fixture) require_value "$@"; FIXTURE="$2"; shift 2 ;;
    --out) require_value "$@"; OUT="$2"; shift 2 ;;
    --theme-dir) require_value "$@"; THEME_DIR="$2"; shift 2 ;;
    --wallpaper) require_value "$@"; WALLPAPER="$2"; shift 2 ;;
    --benchmark) BENCHMARK=1; shift ;;
    --language) require_value "$@"; LANGUAGE="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "omasnap: unknown option '$1'" >&2; usage >&2; exit 2 ;;
  esac
done

if [ -z "$FIXTURE" ]; then
  if ! command -v node >/dev/null 2>&1; then
    echo "omasnap: 'node' was not found on PATH." >&2
    echo "Install it with: sudo pacman -S nodejs" >&2
    exit 1
  fi

  # A live selection is highlighted with the vendored Zed grammars
  # (docs/adr/0002); if none have been compiled yet, say so once, briefly —
  # the highlighter itself still renders (in plain text, uncoloured) rather
  # than failing, so this is a hint, not a blocker.
  if [ -x "$ROOT/bin/build-grammars" ] && ! "$ROOT/bin/build-grammars" --check >/dev/null 2>&1; then
    echo "omasnap: some Zed grammars are not built yet; run bin/install (highlighting will be plain text until then)" >&2
  fi

  # Per-run files under a 0700 directory, each file itself 0600 (the
  # selection text passes through SELECTION) — guaranteed by `umask 077`
  # above, not by the `-m 700` here (belt-and-braces only: it has no effect
  # if this directory already exists from an earlier run, which is the
  # common case). All five are cleaned up on exit by default — correct for
  # benchmark mode and for every early failure below (nothing selected,
  # `node lib/snap.mjs` failing) — right up until the live path's IPC call
  # to the Omasnap shell service actually succeeds, at which point the trap
  # narrows to just SELECTION/WINDOW (see there): that call returns
  # immediately, long before the preview it triggered is closed, and the
  # overlay reads REQUEST (re-highlighting from it when the language
  # selector is used) and writes PREVIEW_PNG for as long as it stays open.
  # That is why `lib/snap.mjs` copies the selection text and window info
  # *into* REQUEST rather than recording their paths: SELECTION and WINDOW
  # are gone the moment this script exits. `app/Service.qml` deletes its own
  # three files once that overlay actually closes (ADR-0003).
  RUNTIME_DIR="$(require_runtime_dir)/omasnap"
  mkdir -p -m 700 "$RUNTIME_DIR"
  verify_private_dir "$RUNTIME_DIR"
  # Unpredictable names, not `-$$` (a PID is guessable/visible to any other
  # process on the machine): a fixed, predictable path let another same-user
  # process plant a symlink there ahead of us, which the `>` redirects below
  # would then write the selection/window/request data through. `mktemp`
  # creates each file now, atomically and privately (mode 600, verified
  # above to be inside a directory only this user can write to), so the
  # later writes reopen a regular file we already own rather than a
  # pathname an attacker could have raced.
  SELECTION="$(mktemp "$RUNTIME_DIR/selection-XXXXXXXX.txt")"
  WINDOW="$(mktemp "$RUNTIME_DIR/window-XXXXXXXX.json")"
  REQUEST="$(mktemp "$RUNTIME_DIR/request-XXXXXXXX.json")"
  INPUT="$(mktemp "$RUNTIME_DIR/input-XXXXXXXX.json")"
  PREVIEW_PNG="$(mktemp "$RUNTIME_DIR/preview-XXXXXXXX.png")"
  trap 'rm -f "$SELECTION" "$WINDOW" "$REQUEST" "$INPUT" "$PREVIEW_PNG"' EXIT

  NODE_ARGS=(--selection "$SELECTION" --window "$WINDOW" --request "$REQUEST" --out "$INPUT")
  if [ -n "$LANGUAGE" ]; then
    NODE_ARGS+=(--language "$LANGUAGE")
  fi

  if [ "$BENCHMARK" -eq 1 ]; then
    total_start=$(date +%s%N)

    t0=$(date +%s%N)
    wl-paste --primary --no-newline > "$SELECTION" 2>/dev/null || true
    if [ ! -s "$SELECTION" ]; then
      wl-paste --no-newline > "$SELECTION" 2>/dev/null || true
    fi
    t1=$(date +%s%N)
    echo "selection: $(( (t1 - t0) / 1000000 )) ms"

    # An empty selection is not a fast exit here (ADR-0010): a snap
    # provider registered for the focused window's class is a complete,
    # self-sufficient answer regardless of what's selected, and
    # `node lib/snap.mjs`/`prepareSnap()` below is the one place that
    # already knows the provider registry — it makes the "is this
    # actually fatal" call itself (its own exit code 3, handled below,
    # exactly as before) rather than this script guessing at it first.

    t0=$(date +%s%N)
    if command -v hyprctl >/dev/null 2>&1 && hyprctl activewindow -j > "$WINDOW" 2>/dev/null; then
      :
    else
      echo '{}' > "$WINDOW"
    fi
    t1=$(date +%s%N)
    echo "window: $(( (t1 - t0) / 1000000 )) ms"

    t0=$(date +%s%N)
    set +e
    node "$ROOT/lib/snap.mjs" "${NODE_ARGS[@]}"
    status=$?
    set -e
    t1=$(date +%s%N)
    echo "prepare: $(( (t1 - t0) / 1000000 )) ms"

    total_end=$(date +%s%N)
    echo "total: $(( (total_end - total_start) / 1000000 )) ms"

    if [ "$status" -eq 3 ]; then
      notify-send "Omasnap" "Nothing selected" 2>/dev/null || true
      exit 0
    elif [ "$status" -ne 0 ]; then
      exit 1
    fi
    exit 0
  fi

  wl-paste --primary --no-newline > "$SELECTION" 2>/dev/null || true
  if [ ! -s "$SELECTION" ]; then
    wl-paste --no-newline > "$SELECTION" 2>/dev/null || true
  fi
  # An empty selection is not a fast exit here (ADR-0010): a snap provider
  # registered for the focused window's class is a complete,
  # self-sufficient answer regardless of what's selected, so this script
  # always hands off to `node lib/snap.mjs` below — the one place that
  # already knows the provider registry — and lets it decide whether an
  # empty selection is actually fatal (its own exit code 3, handled below,
  # exactly as before).

  if command -v hyprctl >/dev/null 2>&1 && hyprctl activewindow -j > "$WINDOW" 2>/dev/null; then
    :
  else
    echo '{}' > "$WINDOW"
  fi

  set +e
  node "$ROOT/lib/snap.mjs" "${NODE_ARGS[@]}"
  status=$?
  set -e
  if [ "$status" -eq 3 ]; then
    notify-send "Omasnap" "Nothing selected" 2>/dev/null || true
    exit 0
  elif [ "$status" -ne 0 ]; then
    notify-send "Omasnap" "Omasnap failed (see terminal)" 2>/dev/null || true
    exit 1
  fi

  # `~/Pictures` (or wherever xdg-user-dir PICTURES points) is created here,
  # once, so Preview.qml's Save action only ever has to write a file, never
  # create a directory.
  PICTURES="$(xdg-user-dir PICTURES 2>/dev/null || true)"
  if [ -z "$PICTURES" ]; then
    PICTURES="$HOME/Pictures"
  fi
  mkdir -p "$PICTURES"

  # Ask the already-running Omarchy shell to show the preview (ADR-0003):
  # app/Service.qml, loaded by the shell as long as this plugin is enabled,
  # replaces any preview it already has open before creating this one — the
  # direct replacement for the old design's `qs kill -p .../Main.qml`. The
  # last two arguments are the OMASNAP_AUTO/OMASNAP_SHOT_PATH testing hooks;
  # a normal snap always passes them empty. Testing that path means calling
  # this IPC target directly, the same way testers previously ran
  # `qs -p app/Main.qml` directly with those two set as environment
  # variables, bypassing this script either way.
  IPC_ERROR="$(mktemp "$RUNTIME_DIR/ipc-error-XXXXXXXX.txt")"
  if ! omarchy-shell omasnap show "$INPUT" "$REQUEST" "$ROOT" "$PREVIEW_PNG" "" "" 2>"$IPC_ERROR"; then
    err="$(cat "$IPC_ERROR" 2>/dev/null)"
    rm -f "$IPC_ERROR"
    echo "omasnap: could not reach the Omasnap shell service ($err)" >&2
    echo "omasnap: is the Omarchy shell running, and is the plugin enabled? Run: omarchy plugin enable com.keithrowell.omasnap" >&2
    notify-send "Omasnap" "Not enabled — run: omarchy plugin enable com.keithrowell.omasnap" 2>/dev/null || true
    # The IPC call never reached a service, so no overlay now owns REQUEST/
    # INPUT/PREVIEW_PNG — leave the default (all five) trap in place.
    exit 1
  fi
  rm -f "$IPC_ERROR"

  # Handed off successfully: app/Service.qml's overlay now owns REQUEST,
  # INPUT and PREVIEW_PNG for as long as it stays open, and deletes them
  # itself on close. Narrow the trap so this script's own exit doesn't
  # delete files the still-open preview is about to read or write.
  # SELECTION and WINDOW stay ours to delete: REQUEST carries their
  # contents, so nothing reads them after this point.
  trap 'rm -f "$SELECTION" "$WINDOW"' EXIT

  exit 0
fi

if [ -z "$OUT" ]; then
  echo "omasnap: --out is required with --fixture" >&2
  usage >&2
  exit 2
fi

if ! command -v node >/dev/null 2>&1; then
  echo "omasnap: 'node' was not found on PATH." >&2
  echo "Install it with: sudo pacman -S nodejs" >&2
  exit 1
fi

# Resolved in two steps, not `$(readlink -f "$(dirname "$OUT")")/$(basename
# "$OUT")` in one: when the directory doesn't exist, `readlink -f` on it
# fails and prints nothing, but that failure is masked by the *second*
# (always-successful) `$(basename ...)` substitution — a compound
# assignment's exit status is that of its last command substitution, so
# `set -e` never saw it, and `--out bogus-dir/x.png` silently resolved to
# `/x.png`. Checking the directory explicitly first fails loudly instead.
OUT_DIR="$(dirname "$OUT")"
if [ ! -d "$OUT_DIR" ]; then
  echo "omasnap: --out's directory '$OUT_DIR' does not exist" >&2
  exit 2
fi
OUT="$(readlink -f "$OUT_DIR")/$(basename "$OUT")"

RUNTIME_DIR="$(require_runtime_dir)/omasnap"
mkdir -p -m 700 "$RUNTIME_DIR"
verify_private_dir "$RUNTIME_DIR"
INPUT="$(mktemp "$RUNTIME_DIR/input-XXXXXXXX.json")"
trap 'rm -f "$INPUT"' EXIT

INPUT_ARGS=(--fixture "$FIXTURE")
if [ -n "$THEME_DIR" ]; then
  INPUT_ARGS+=(--theme-dir "$THEME_DIR")
fi
if [ -n "$WALLPAPER" ]; then
  INPUT_ARGS+=(--wallpaper "$WALLPAPER")
fi

# `set -e` propagates a non-zero exit from either command below as this
# script's own exit status.
node "$ROOT/lib/input.mjs" "${INPUT_ARGS[@]}" > "$INPUT"
OMASNAP_INPUT="$INPUT" OMASNAP_OUT="$OUT" qs -p "$ROOT/app/Main.qml"

if [ -s "$OUT" ]; then
  echo "wrote $OUT"
else
  echo "omasnap: qs exited 0 but $OUT is missing or empty" >&2
  exit 1
fi
